+    <div class="eyebrow">Propuesta comercial</div>
+    <h1>Presupuesto {{ propuesta.presupuesto_numero }}</h1>
+    {% if propuesta.presupuesto_titulo %}<p class="titulo">{{ propuesta.presupuesto_titulo }}</p>{% endif %}
+    <div class="grid">
+      <div class="dato"><span>Preparado para</span><strong>{{ propuesta.cliente_nombre or 'Cliente' }}</strong></div>
+      <div class="dato"><span>Fecha</span><strong>{{ propuesta.fecha_presupuesto.strftime('%d/%m/%Y') }}</strong></div>
+      <div class="dato"><span>Válido hasta</span><strong>{{ propuesta.valido_hasta.strftime('%d/%m/%Y') }}</strong></div>
+      <div class="dato total"><span>Total</span><strong>{{ propuesta.total | money(propuesta.moneda) }}</strong></div>
+    </div>
+    <div class="acciones">
+      <a class="btn primario" href="/propuestas/{{ token }}/pdf" target="_blank" rel="noreferrer">Ver propuesta en PDF</a>
+      <a class="btn secundario" href="/propuestas/{{ token }}/pdf?download=1" rel="noreferrer">Descargar PDF</a>
+    </div>
+    <div class="aviso">Este enlace es confidencial y da acceso únicamente a esta versión de la propuesta. No lo reenvíes a personas que no deban consultar el documento.</div>
+
+    {% if error_respuesta %}<div class="error" role="alert">{{ error_respuesta }}</div>{% endif %}
+    {% if propuesta.respuesta == 'pendiente' %}
+    <div class="respuesta">
+      <h2>Responder la propuesta</h2>
+      <p class="intro">Tu respuesta quedará asociada a esta versión exacta del presupuesto, junto con tu identidad declarada y la fecha y hora.</p>
+      <form method="post" action="/propuestas/{{ token }}/responder">
+        <div class="campo"><label for="nombre">Nombre completo</label><input id="nombre" name="nombre" type="text" maxlength="200" value="{{ datos_respuesta.nombre }}" required></div>
+        <div class="campo"><label for="email">Email</label><input id="email" name="email" type="email" maxlength="254" value="{{ datos_respuesta.email }}" required></div>
+        <div class="campo"><label for="comentario">Comentario opcional</label><textarea id="comentario" name="comentario" rows="4" maxlength="2000">{{ datos_respuesta.comentario }}</textarea></div>
+        <label class="declaracion"><input type="checkbox" name="declaracion" value="confirmada" required><span>Confirmo que soy el destinatario o que estoy autorizado para aceptar o rechazar esta propuesta.</span></label>
+        <div class="decision">
+          <button class="btn primario" type="submit" name="decision" value="aceptada">Aceptar propuesta</button>
+          <button class="btn rechazar" type="submit" name="decision" value="rechazada">Rechazar propuesta</button>
+        </div>
+      </form>
+    </div>
+    {% else %}
+    <div class="resultado {{ propuesta.respuesta }}" role="status">
+      <h2>Propuesta {{ 'aceptada' if propuesta.respuesta == 'aceptada' else 'rechazada' }}</h2>
+      <p>Respuesta registrada por <strong>{{ propuesta.respondido_por_nombre }}</strong>{% if propuesta.responded_at %} el {{ propuesta.responded_at.strftime('%d/%m/%Y a las %H:%M') }} UTC{% endif %}. Esta versión ya no admite otra respuesta.</p>
+      {% if propuesta.notificacion_enviada_at %}<p>La empresa fue notificada automáticamente.</p>{% elif propuesta.notificacion_error %}<p>La respuesta está guardada correctamente. La empresa puede consultarla dentro de CotizaT aunque el aviso por correo no haya podido entregarse.</p>{% endif %}
+    </div>
+    {% endif %}
+  </div>
+  <footer>El alcance, los importes, la vigencia y las condiciones completas están en el PDF congelado.</footer>
+</main>
+</body>
+</html>
