{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": [
    "yul1"
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/recordatorios-vencimiento",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/mantenimiento",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/marketing",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cotizat.online"
        }
      ],
      "destination": "https://cotizat.online/:path*",
      "permanent": true
    }
  ]
}
