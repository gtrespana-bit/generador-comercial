+(function(){
+  var paisSel = document.getElementById('select-pais');
+  var etiquetaInput = document.getElementById('input-etiqueta');
+  var labelRif = document.getElementById('label-rif');
+  var monedaSel = document.getElementById('select-moneda');
+  var ivaInput = document.getElementById('input-iva');
+  var tasaInput = document.getElementById('input-tasa');
+  var fechaInput = document.getElementById('input-fecha-tasa');
+  var labelTasaMoneda = document.getElementById('label-tasa-moneda');
+  var labelTasaSimbolo = document.getElementById('label-tasa-simbolo');
+  var hintTasa = document.getElementById('hint-tasa');
+  var btnAuto = document.getElementById('btn-tasa-auto');
+  if(!paisSel) return;
+  var MAPA = {
+    'Venezuela': {etiqueta:'RIF', iva:16, moneda:'VES', tasa:36.5},
+    'Colombia': {etiqueta:'NIT', iva:19, moneda:'COP', tasa:4200},
+    'México': {etiqueta:'RFC', iva:16, moneda:'MXN', tasa:17.2},
+    'Ecuador': {etiqueta:'RUC', iva:15, moneda:'USD', tasa:1},
+    'Perú': {etiqueta:'RUC', iva:18, moneda:'PEN', tasa:3.75},
+    '': {etiqueta:'ID fiscal', iva:16, moneda:'USD', tasa:1}
+  };
+  function actualizarPorPais(autoTasa){
+    var pais = paisSel.value || '';
+    var cfg = MAPA[pais] || MAPA[''];
+    if(etiquetaInput && !etiquetaInput.dataset.tocado) { etiquetaInput.value = cfg.etiqueta; if(labelRif) labelRif.textContent = cfg.etiqueta; }
+    if(ivaInput && !ivaInput.dataset.tocado) ivaInput.value = cfg.iva;
+    if(monedaSel && !monedaSel.dataset.tocado) monedaSel.value = cfg.moneda;
+    if(labelTasaMoneda) labelTasaMoneda.textContent = cfg.moneda;
+    if(labelTasaSimbolo) labelTasaSimbolo.textContent = cfg.moneda;
+    if(hintTasa){
+      if(cfg.moneda === 'USD') hintTasa.textContent = 'Tu moneda es USD — no necesitas tasa. Deja 1.';
+      else hintTasa.textContent = 'Sugerido para '+pais+': 1 USD = '+cfg.tasa+' '+cfg.moneda+' — puedes ajustarlo o pulsar «Tasa de hoy».';
+    }
+    if(autoTasa && tasaInput && !tasaInput.value){
+      tasaInput.value = cfg.tasa;
+      if(fechaInput && !fechaInput.value) fechaInput.value = new Date().toISOString().slice(0,10);
+    }
+  }
+  // marca tocado si el usuario edita manual
+  [etiquetaInput, ivaInput, monedaSel].forEach(function(el){
+    if(!el) return;
+    el.addEventListener('change', function(){ el.dataset.tocado='1'; });
+    el.addEventListener('input', function(){ el.dataset.tocado='1'; });
+  });
+  paisSel.addEventListener('change', function(){ 
+    // al cambiar país, resetea tocado para sugerir de nuevo
+    if(etiquetaInput) delete etiquetaInput.dataset.tocado;
+    if(ivaInput) delete ivaInput.dataset.tocado;
+    if(monedaSel) delete monedaSel.dataset.tocado;
+    actualizarPorPais(true);
+  });
+  // moneda cambia -> actualiza label tasa
+  if(monedaSel){
+    monedaSel.addEventListener('change', function(){
+      if(labelTasaMoneda) labelTasaMoneda.textContent = monedaSel.value;
+      if(labelTasaSimbolo) labelTasaSimbolo.textContent = monedaSel.value;
+    });
+  }
+  if(btnAuto){
+    btnAuto.addEventListener('click', function(){
+      var moneda = monedaSel ? monedaSel.value : 'COP';
+      if(moneda === 'VES' || moneda === 'Bs') moneda='VES';
+      btnAuto.textContent='⏳ Consultando...';
+      btnAuto.disabled=true;
+      fetch('/configuracion/tasa-auto?moneda='+encodeURIComponent(moneda), {headers:{'Accept':'application/json'}})
+        .then(function(r){ return r.json(); })
+        .then(function(j){
+          if(j.ok && j.tasa){
+            tasaInput.value = j.tasa;
+            if(fechaInput) fechaInput.value = j.fecha || new Date().toISOString().slice(0,10);
+            hintTasa.textContent = 'Tasa de hoy: 1 USD = '+j.tasa+' '+moneda+' (fuente: open.er-api.com)';
+          } else {
+            hintTasa.textContent = 'No se pudo traer la tasa: '+(j.error||'sin conexión')+'. Revisa manual.';
+          }
+        })
+        .catch(function(e){
+          hintTasa.textContent = 'Sin conexión — pon la tasa manual.';
+        })
+        .finally(function(){
+          btnAuto.textContent='↻ Tasa de hoy (auto)';
+          btnAuto.disabled=false;
+        });
+    });
+  }
+  // inicial
+  actualizarPorPais(false);
+})();
+</script>
 
