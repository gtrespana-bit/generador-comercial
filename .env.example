# Copia estas variables al entorno; no confirmes contraseñas reales en Git.
# La aplicación no carga este archivo automáticamente.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/cotizat

# Supabase Auth. La clave publicable puede llegar al navegador; nunca uses aquí
# sb_secret_... ni la clave service_role.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Debe permanecer activada en cualquier despliegue HTTPS. Solo se desactiva al
# probar Supabase Auth expresamente sobre http://localhost.
COTIZAT_COOKIE_SECURE=true

# Compatibilidad temporal exclusiva de SQLite local. PostgreSQL ignora esta
# variable y deriva la organización desde la membresía autenticada.
COTIZAT_ORGANIZATION_ID=1
