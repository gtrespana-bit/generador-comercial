# Copia estas variables al entorno; no confirmes contraseñas reales en Git.
# La aplicación no carga este archivo automáticamente.

# Entorno explícito (E4-003): development, test o production. Lo detecta
# app/config.py; en Vercel no hace falta (VERCEL_ENV=production ya lo marca).
# En producción activa las exigencias duras de configuración; en desarrollo y
# pruebas no se exige nada para no obstaculizar el trabajo local.
COTIZAT_ENV=development

# Runtime web: login no privilegiado, miembro de cotizat_app y sin BYPASSRLS.
DATABASE_URL=postgresql://cotizat_runtime:REEMPLAZAR@localhost:5432/cotizat
# Solo para `alembic upgrade head`; no debe llegar al proceso web en runtime.
MIGRATION_DATABASE_URL=postgresql://administrador:REEMPLAZAR@localhost:5432/cotizat
# Hace fallar el arranque si DATABASE_URL omite RLS o usa postgres/service role.
COTIZAT_REQUIRE_RLS_ROLE=true

# Supabase Auth. Esta variable admite solo la clave publicable; nunca coloques
# aquí una sb_secret_... ni la clave service_role.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Rendimiento de autenticación (E-PERF). Segundos que se reutiliza una
# identidad ya validada sin volver a llamar a Supabase Auth en cada página
# (la conexión al servidor es keep-alive y la identidad se cachea por token;
# nunca más allá del 90 % de la vida útil restante del JWT). 0 desactiva la
# caché y vuelve a validar en cada petición. Por omisión 180.
COTIZAT_AUTH_CACHE_TTL=180

# Rendimiento de /recursos (E-PERF). Segundos mínimos entre sincronizaciones
# automáticas de recursos por organización al ABRIR la página (los guardados
# siempre sincronizan). La sincronización recorre todos los descompuestos del
# catálogo y con base remota era la mayor parte del tiempo de carga. 0 la
# ejecuta en cada visita (comportamiento antiguo). Por omisión 600.
COTIZAT_SYNC_RECURSOS_TTL=600

# Storage privado. En PostgreSQL el backend predeterminado es Supabase; en
# SQLite es local. La clave secreta es EXCLUSIVA del proceso servidor.
COTIZAT_STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=cotizat-private
SUPABASE_SECRET_KEY=REEMPLAZAR_CON_SB_SECRET_SOLO_EN_EL_BACKEND

# Debe permanecer activada en cualquier despliegue HTTPS. Solo se desactiva al
# probar Supabase Auth expresamente sobre http://localhost.
COTIZAT_COOKIE_SECURE=true
# Origen público exacto autorizado en Supabase para enlaces de recuperación.
COTIZAT_PUBLIC_URL=https://cotizat.example.com
# Activa X-Forwarded-For solo detrás de un proxy conocido que lo sanee (Vercel,
# balanceador propio, etc.). Déjalo en false si el proceso recibe Internet.
COTIZAT_TRUST_PROXY=false

# Contador de intentos de acceso compartido entre instancias. Sin estas dos
# variables el límite se cuenta en la memoria de cada proceso, lo que en un
# despliegue serverless (Vercel) equivale a no limitar: cada invocación arranca
# el contador de cero. Se usa la API REST de Upstash Redis; el token es
# EXCLUSIVO del backend.
UPSTASH_REDIS_REST_URL=https://tu-base.upstash.io
UPSTASH_REDIS_REST_TOKEN=REEMPLAZAR_SOLO_EN_EL_BACKEND
# Hace que /readyz falle si el contador anterior no está configurado. Actívalo
# en cualquier despliegue con más de una instancia; en SQLite se ignora.
COTIZAT_REQUIRE_DISTRIBUTED_RATELIMIT=true

# Envío de correos transaccionales (invitaciones de equipo) por Resend. La
# clave es EXCLUSIVA del backend. Sin estas dos variables no se envía nada:
# /equipo muestra el enlace una sola vez, como hasta ahora. COTIZAT_EMAIL_FROM
# debe ser una dirección del dominio verificado en Resend.
RESEND_API_KEY=re_REEMPLAZAR_SOLO_EN_EL_BACKEND
COTIZAT_EMAIL_FROM=CotizaT <no-responder@tu-dominio.com>

# Trabajo programado (Vercel Cron). El recordatorio de vencimiento de licencia
# (5 y 1 día antes) se dispara una vez al día desde `vercel.json` → `crons`.
# Vercel autentica cada invocación con `Authorization: Bearer $CRON_SECRET`; la
# ruta la verifica en tiempo constante. Sin esta variable, el cron queda
# cerrado (y Vercel no autentica la llamada). Genera un valor fuerte:
#   openssl rand -base64 32
CRON_SECRET=REEMPLAZAR_SOLO_EN_EL_BACKEND
# Mantenimiento diario (E4-021/E4-023): un segundo cron (/api/cron/mantenimiento,
# 02:00 UTC) genera el respaldo automático por organización y verifica /readyz
# alertando por correo a COTIZAT_OPERADORES si falla. El plan Hobby admite
# hasta 2 trabajos diarios; Pro hasta 40.
# COTIZAT_RESPALDO_AUTOMATICO=true     # interruptor (false apaga el barrido)
# COTIZAT_RESPALDO_RETENCION=14        # copias diarias conservadas por org
# COTIZAT_RESPALDO_MAX_MB=12           # tope del paquete por org (tope del bucket)

# Stripe Checkout (tarjeta, Apple Pay, Google Pay). Sin estas dos variables
# el botón de tarjeta no aparece y el cobro manual sigue siendo el único
# camino. La clave es EXCLUSIVA del backend; el webhook verifica
# Stripe-Signature. Cuenta del titular en España; cobro en USD.
# STRIPE_SECRET_KEY=sk_test_REEMPLAZAR_SOLO_EN_EL_BACKEND
# STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR_SOLO_EN_EL_BACKEND

# Panel de operador (/admin/licencias, E1-060). Correos autorizados a
# administrar licencias, separados por comas. Vacío significa ningún operador:
# el panel queda cerrado para todo el mundo (valor seguro). Solo se cambia en
# el panel del despliegue y se redespliega; no hay pantalla para nombrar
# operadores a propósito.
COTIZAT_OPERADORES=

# Corte automático de acceso (E1-060). Con "true", una organización web sin
# licencia vigente no puede entrar a sus pantallas de trabajo (los datos no se
# tocan y vuelven al renovar). Valor por omisión: desactivado. Antes de
# activarlo concede una licencia de cortesía a tu propia organización. No
# afecta a la instalación de escritorio (SQLite jamás exige licencia).
COTIZAT_EXIGIR_LICENCIA=false

# Prueba gratuita al crear la primera organización. Días de acceso que se
# conceden automáticamente. Por omisión 7. El tope duro son 90 días, aplicado
# también dentro de la base de datos. Un valor menor que 1 desactiva la prueba
# por completo: los registros nuevos irán directos a la pantalla de planes.
#
# La prueba es una por identidad de correo y para siempre: se registra el email
# normalizado (sin puntos ni +etiqueta en los proveedores que los ignoran) para
# que no se pueda reciclar la misma cuenta con alias. La licencia se otorga a la
# ORGANIZACIÓN, así que una segunda organización no trae otra prueba.
COTIZAT_DIAS_PRUEBA=7

# Sal del hash con el que se guarda la IP del alta. La IP nunca se almacena en
# claro y solo sirve para que el panel señale patrones de registros repetidos;
# jamás bloquea a nadie automáticamente. Si se deja vacía se usa
# SUPABASE_SECRET_KEY. Cambiarla invalida las coincidencias ya registradas.
COTIZAT_HASH_SALT=

# Compatibilidad temporal exclusiva de SQLite local. PostgreSQL ignora esta
# variable y deriva la organización desde la membresía autenticada.
COTIZAT_ORGANIZATION_ID=1

# Asistente de IA. Las búsquedas en datos propios, revisiones y acciones del
# editor funcionan localmente sin clave. Groq habilita conversación y redacción
# generativa con OpenAI GPT OSS 120B; su capa gratuita tiene cuotas definidas
# por el proveedor y no debe considerarse uso ilimitado garantizado.
# Obtén tu clave en https://console.groq.com/keys. Sin esta variable, el
# asistente conserva todas sus herramientas deterministas de CotizaT.
# GROQ_API_KEY=gsk_REEMPLAZAR_SOLO_EN_EL_BACKEND
# COTIZAT_IA_MODEL=openai/gpt-oss-120b

# Etiqueta de Google Analytics 4 (medición de audiencia). El ID de medición
# NO es un secreto: viaja en el HTML. En producción (VERCEL_ENV=production)
# se usa G-013NT3ZTHP aunque esta variable no esté definida, para que el
# detector de Google encuentre la etiqueta sin depender de un redespliegue.
# En desarrollo no se renderiza nada. Apágalo con COTIZAT_GA_ID=off.
# Tras cambiarla en Vercel hay que redesplegar.
# COTIZAT_GA_ID=G-013NT3ZTHP
